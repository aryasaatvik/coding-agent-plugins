{
  "name": "coding-agent-plugins",
  "version": "1.0.0",
  "private": true,
  "description": "Collection of plugins for Claude Code and OpenCode",
  "keywords": [
    "claude-code",
    "development-tools",
    "ni",
    "opencode",
    "package-manager",
    "plugins"
  ],
  "license": "MIT",
  "author": "Saatvik Arya",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryasaatvik/coding-agent-plugins"
  },
  "workspaces": [
    "plugins/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "install-plugins": "bun packages/cli/bin/cli.js",
    "build": "turbo run build",
    "test": "bun test ./plugins",
    "dev": "turbo run dev --parallel",
    "generate": "turbo gen",
    "clean": "turbo run clean && rm -rf .turbo",
    "typecheck": "tsc --noEmit -p .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "test:artifact": "bun scripts/test-artifact.ts",
    "release:check": "bun run check && bun run build && bun run test:artifact"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  },
  "devDependencies": {
    "@turbo/gen": "^2.11.3",
    "@types/bun": "latest",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.2"
}
